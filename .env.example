# ==============================================================================
# EduCompra Humm — Plantilla de Variables de Entorno (.env.example)
# ==============================================================================

# Entorno: development | production
DJANGO_ENV=development

# Clave secreta (en producción generar un valor aleatorio de al menos 50 caracteres)
SECRET_KEY=django-insecure-educompra-humm-dev-key-change-in-production-!#@$

# Modo Debug (False estricto en producción)
DEBUG=True

# Hosts autorizados (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1,educompra.humm.cl

# Base de datos
# Opciones para DB_ENGINE: django.db.backends.sqlite3 | django.db.backends.mysql
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Rutas estáticas y media (utilizadas en producción HostGator)
STATIC_ROOT=
MEDIA_ROOT=

# Parámetros del Negocio por Defecto
TIPO_CAMBIO_DEFAULT=950.00
RECARGO_GENERAL_DEFAULT=80.00
FACTOR_INTERNACION_DEFAULT=15.00
IVA_DEFAULT=19.00
EMAIL_NOTIFICACIONES_DEFAULT=contacto@humm.cl
